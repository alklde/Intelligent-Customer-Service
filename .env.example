# ===== LLM（OpenAI 兼容接口）=====
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.0
LLM_REQUEST_TIMEOUT=60.0

# ===== Embedding =====
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ===== Qdrant / Redis =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_knowledge_base
QDRANT_TOP_K=4
REDIS_URL=redis://localhost:6379/1

# ===== 账号与认证 =====
AUTH_TOKEN_TTL_CUSTOMER=86400
AUTH_TOKEN_TTL_STAFF=43200
CAPTCHA_TTL=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
ADMIN_BOOTSTRAP_KEY=SUITE-BOOTSTRAP-2026

# ===== 知识库 =====
KB_CHUNK_SIZE=420
KB_CHUNK_OVERLAP=60
KB_MIN_CHARS=20
KB_MAX_CHARS=50000

# ===== 工具熔断 =====
TOOL_TIMEOUT=3.0
MAX_TOOL_FAILURES=3